CANCERJEV_GDC_BASE_URL=https://api.gdc.cancer.gov
CANCERJEV_GDC_TIMEOUT_SECONDS=30
CANCERJEV_GDC_MAX_CONNECTIONS=8
CANCERJEV_GDC_MAX_RESPONSE_BYTES=100000000
CANCERJEV_DATABASE_URL=postgresql+psycopg://cancerjev:cancerjev-local@localhost/cancerjev
CANCERJEV_JOB_LEASE_SECONDS=60
CANCERJEV_SNAPSHOT_ROOT=.data/snapshots
CANCERJEV_OBJECT_BACKEND=filesystem
CANCERJEV_OBJECT_ROOT=.data/objects
# For S3 use OBJECT_BACKEND=s3, OBJECT_BUCKET and optionally OBJECT_ENDPOINT_URL.
# Authentication uses the standard AWS credential provider chain.

