CANCERJEV_GDC_BASE_URL=https://api.gdc.cancer.gov
CANCERJEV_GDC_TIMEOUT_SECONDS=30
CANCERJEV_GDC_MAX_CONNECTIONS=8
CANCERJEV_SNAPSHOT_ROOT=.data/snapshots

# Generative research model (OpenRouter-compatible chat/completions API).
CANCERJEV_LLM_BASE_URL=https://openrouter.ai/api/v1
CANCERJEV_LLM_API_KEY=
CANCERJEV_LLM_MODEL=openai/gpt-5-mini

# Jev uses its own TypeSafe System One provider, key, endpoint, and model.
CANCERJEV_JEV_BASE_URL=https://api.typesafe.ai
CANCERJEV_JEV_API_KEY=
CANCERJEV_JEV_MODEL=jev-latest
CANCERJEV_AI_TIMEOUT_SECONDS=30
